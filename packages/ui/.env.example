NEXT_PUBLIC_POSTHOG_KEY=<your_key>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only: Cairo-Coder API integration
# Base URL of the Cairo-Coder API (no trailing slash)
CAIRO_CODER_API_BASE_URL=https://api.cairo-coder.com
# API key used by the server-side proxy route; never expose on client
CAIRO_CODER_API_KEY=5a3f121a55bafa5ae3536a146ec10007899d3fb1b5321bcba40477dabeed4584
# Optional: customize how the key is sent to the upstream API
# Default is Authorization: Bearer <key>
# CAIRO_CODER_API_AUTH_HEADER=Authorization
# CAIRO_CODER_API_AUTH_PREFIX="Bearer "
